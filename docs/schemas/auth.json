{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "认证相关 Schema — 园林工程智能采购助手",
  "definitions": {
    "LoginRequest": {
      "description": "登录（即注册）请求",
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "用户名"
        },
        "password": {
          "type": "string",
          "minLength": 6,
          "description": "密码明文（HTTPS 传输）"
        }
      },
      "python_class": "app.schemas.auth.LoginRequest"
    },
    "Token": {
      "description": "登录成功返回的 Token",
      "type": "object",
      "required": ["access_token", "token_type"],
      "properties": {
        "access_token": {
          "type": "string",
          "description": "JWT 字符串"
        },
        "token_type": {
          "type": "string",
          "enum": ["bearer"],
          "description": "固定为 bearer"
        }
      },
      "python_class": "app.schemas.auth.Token"
    },
    "UserInfo": {
      "description": "当前登录用户信息",
      "type": "object",
      "required": ["user_id", "username"],
      "properties": {
        "user_id": { "type": "integer" },
        "username": { "type": "string" },
        "display_name": { "type": "string" },
        "team_id": { "type": ["integer", "null"], "description": "未加入团队时为 null" },
        "role": {
          "type": ["string", "null"],
          "enum": ["owner", "member", null],
          "description": "团队角色"
        }
      },
      "python_class": "app.schemas.auth.UserInfo"
    },
    "TeamCreate": {
      "description": "创建团队请求",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "团队名称"
        }
      },
      "python_class": "app.schemas.auth.TeamCreate"
    },
    "TeamCreateResult": {
      "description": "创建团队响应",
      "type": "object",
      "required": ["team_id", "name", "invite_code"],
      "properties": {
        "team_id": { "type": "integer" },
        "name": { "type": "string" },
        "invite_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{6}$",
          "description": "6 位大写字母+数字邀请码"
        }
      },
      "python_class": "app.schemas.auth.TeamCreateResult"
    },
    "TeamJoin": {
      "description": "加入团队请求",
      "type": "object",
      "required": ["invite_code"],
      "properties": {
        "invite_code": {
          "type": "string",
          "description": "邀请码"
        }
      },
      "python_class": "app.schemas.auth.TeamJoin"
    }
  }
}
