# ============================================================
# 园林工程智能采购助手 — 环境变量模板
# 依据: docs/tech-stack.md §9.3
# 用法: 从项目根目录复制为 backend/.env 并填入真实值（.env 不提交到 Git）
# ============================================================

# ---------- 数据库 ----------
# SQLite 异步连接串（aiosqlite 驱动）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- 大模型（三档分工，开发者服务端预置） ----------
# 说明: MVP 阶段由开发者在服务端配置，用户无需配置（PRD FR-10, NFR-4）
# 支持 OpenAI 兼容接口，可切换 DeepSeek/通义/智谱等

# 轻量档（结构化提取、路由分类、摘要压缩）
LLM_LIGHT_MODEL=deepseek-v3
LLM_LIGHT_BASE_URL=https://api.deepseek.com/v1
LLM_LIGHT_API_KEY=sk-xxx

# 中量档（对话、知识库检索回答、趋势分析）
LLM_MEDIUM_MODEL=gpt-4o
LLM_MEDIUM_BASE_URL=https://api.openai.com/v1
LLM_MEDIUM_API_KEY=sk-xxx

# 重量档（比价建议、复杂推理）
LLM_HEAVY_MODEL=your-heavy-model
# 必须为 OpenAI 兼容聊天接口；Anthropic 原生接口不能直接使用
LLM_HEAVY_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_HEAVY_API_KEY=sk-xxx

# 嵌入档（向量嵌入，与大模型同供应商便于计费与排障）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxx

# ---------- JEV 意图路由（TypeSafe System One，非 OpenAI 兼容） ----------
# 不配置 Key 时自动停用，走规则 + 轻量模型降级（测试/CI 不会联网）
# JEV_API_KEY 与 MAKERS_MODELS_KEY 二选一（后者兼容 EdgeOne Makers 命名）
JEV_ENABLED=true
JEV_API_KEY=
MAKERS_MODELS_KEY=
JEV_ENDPOINT=https://ai-gateway.edgeone.link/v1/systemone
JEV_MODEL=@makers/jev
JEV_CONCURRENCY=24
JEV_TIMEOUT_S=10
# 路由低置信度阈值：JEV 低于该值先走规则/轻量模型降级；
# 降级结果仍低于该值才触发人工确认弹窗
JEV_LOW_CONFIDENCE_THRESHOLD=0.60
# 待确认路由选择有效期（分钟）
ROUTE_CONFIRM_TTL_MINUTES=30

# ---------- JWT 认证 ----------
# 生产环境必须修改 JWT_SECRET
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 文件存储 ----------
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=5

# ---------- 应用配置 ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- 知识库检索配置 ----------
# 混合检索权重（参考 tech-stack.md §6.4）
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
# 喂给大模型的精排数量（检索 Top-20，喂 Top-5）
RAG_TOP_K=5

# ---------- 比价权重默认值（参考 PRD FR-5） ----------
# 总和必须为 1.0，主管可在团队设置中调整
COMPARE_WEIGHT_PRICE=0.4
COMPARE_WEIGHT_HISTORY=0.3
COMPARE_WEIGHT_DELIVERY=0.2
COMPARE_WEIGHT_PAYMENT=0.1

# ---------- 对话记忆压缩 ----------
# 保留最近 N 轮原文
MEMORY_RECENT_TURNS=6
# 压缩阈值：窗口接近模型上下文上限的百分比
MEMORY_COMPRESS_THRESHOLD=0.7

# ---------- 数据库连接池（多 worker 部署调优） ----------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------- LLM 并发闸门与超时 ----------
# 并发上限（0 表示该档位不限制）；超时仅作用于非流式调用
LLM_LIGHT_CONCURRENCY=24
LLM_MEDIUM_CONCURRENCY=16
LLM_HEAVY_CONCURRENCY=8
EMBEDDING_CONCURRENCY=16
LLM_LIGHT_TIMEOUT_S=60
LLM_MEDIUM_TIMEOUT_S=180
LLM_HEAVY_TIMEOUT_S=300
EMBEDDING_TIMEOUT_S=60
# 非流式调用的尝试次数与退避起始秒数（仅网络类瞬时错误）
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_S=1.0

# ---------- 检索重排序（默认关闭，需评测裁决后开启） ----------
RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATES=20
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_CONCURRENCY=8
RERANK_TIMEOUT_S=30

# ---------- Chroma 向量库 ----------
CHROMA_DIR=./chroma
# 留空使用进程内嵌入式模式；填写主机名则连接独立 Chroma 服务
CHROMA_HTTP_HOST=
CHROMA_HTTP_PORT=8000
